# 로컬 개발용 템플릿. 복사해서 .env.local 로 쓰고, 실제 값은 커밋하지 않는다.
# 운영 값은 Vercel 프로젝트의 Production 환경변수에 설정한다. → docs/operations.md

# 문의·대기명단 알림 메일 발송 (Gmail 앱 비밀번호 16자리)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 알림을 받을 주소 (미설정 시 lib/mail.ts 기본값)
NOTIFY_EMAIL=

# 대기명단 누적 저장 — Upstash Redis REST (Vercel Marketplace 연동 시 자동 주입)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 대기명단 CSV 내려받기 인증 토큰 (임의의 긴 문자열)
WAITLIST_ADMIN_TOKEN=
